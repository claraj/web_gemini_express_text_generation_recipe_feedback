<h2>Admin Page - Feedback</h2>

<h3>Select a department</h3>

<form>   
     {{!--no action - makes a GET request to the same page that loaded this form   --}}
<select name="department">
    <option value="" disabled selected hidden>Choose an option</option>
    {{#each departmentNames}}
        <option value="{{this}}">{{ this }}</option>
    {{/each}}
</select>

<button id="choose-department">Select department</button>

</form>

<h3>{{ feedbackHeading }}</h3>

{{#if feedback}}


<table>

    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>email</th>
            <th>Comments</th>
            <th>Current Student</th>
            <th>Department(s)</th>
            <th>Date Created</th>

        </tr>
    </thead>

    <tbody>
            {{#each feedback}}
        <tr>
            <td>{{this.id}}</td>
            <td>{{this.name}}</td>
            <td>{{this.email}}</td>
            <td>{{this.comments}}</td>

            <td>
                {{#if this.currentStudent}}
                    Yes
                {{else}}
                    No
                {{/if}}
            </td>
            <td>{{this.departments}}</td>
            <td>{{this.createdAt}}</td>

        </tr>

    {{/each}}
    </tbody>
</table>

{{else}}

    <p>No feedback found</p>

{{/if}}



</table>